# ════════════════════════════════════════════════════════════
# KIMY — Variables de Entorno para Producción
# ════════════════════════════════════════════════════════════
# Servicios Free Tier:
#   DB → Supabase (postgresql + pgvector)
#   Redis → Upstash (TLS obligatorio)
#   Storage → Cloudflare R2 (S3-compatible, sin costo de salida)
#   Backend → Render Web Service (se apaga tras 15min inactividad)
#   Frontend → Vercel (siempre activo)
# ════════════════════════════════════════════════════════════

# ─── Base de datos (Supabase PostgreSQL + pgvector) ────
# Crear proyecto en supabase.com → Settings → Database → Connection string
# Luego en Supabase SQL Editor ejecutar: CREATE EXTENSION IF NOT EXISTS vector;
DATABASE_URL=postgresql://postgres:YOUR_SUPABASE_PASSWORD@db.YOUR_REF.supabase.co:5432/postgres

# ─── Redis (Upstash) ────
# Crear base en upstash.com → Copiar endpoint y contraseña
REDIS_HOST=YOUR_REGION.upstash.io
REDIS_PORT=32771
REDIS_PASSWORD=YOUR_UPSTASH_PASSWORD
REDIS_TLS=true

# ─── Storage S3-compatible (Cloudflare R2) ────
# Crear bucket en cloudflare.com/r2 → Generate Access Key
S3_ENDPOINT=YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_ACCESS_KEY=YOUR_R2_ACCESS_KEY
S3_SECRET_KEY=YOUR_R2_SECRET_KEY
S3_BUCKET=thesis-documents
S3_REGION=auto
S3_USE_SSL=true

# ─── IA Provider ────
# Al menos UNA key debe estar configurada o el sistema usará simulación
# Groq recomenda (gratuito, 30 req/min): console.groq.com
GROQ_API_KEY=YOUR_GROQ_API_KEY
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile

# OpenAI (requiere saldo): platform.openai.com
# OPENAI_API_KEY=sk-YOUR_OPENAI_KEY
# AI_PROVIDER=openai
# AI_MODEL=gpt-4o-mini     ← más barato para producción
# AI_EMBEDDING_MODEL=text-embedding-3-large

# DeepSeek (muy barato): platform.deepseek.com
# DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_KEY
# AI_PROVIDER=deepseek
# AI_MODEL=deepseek-chat

# Gemini (gratuito limitado): aistudio.google.com
# GEMINI_API_KEY=YOUR_GEMINI_KEY
# AI_PROVIDER=gemini
# AI_MODEL=gemini-2.0-flash

# ─── Auth ────
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_EXPIRES_IN=7d
NEXTAUTH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_STRING
NEXTAUTH_URL=https://kimy-web.vercel.app

# ─── Configuración académica ────
MAX_GRADE=20
LOW_COMPLIANCE_ALERT=60
INSTITUTION_NAME=Universidad Nacional

# ─── Fine-tuning ────
FT_MIN_PAIRS=500

# ─── Encriptación ────
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── Frontend ────
NEXT_PUBLIC_API_URL=https://kimy-api.onrender.com
FRONTEND_URL=https://kimy-web.vercel.app
API_PORT=3001

# ─── Email (opcional: Gmail App Password o SendGrid free) ────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ─── ORCID (opcional: orcid.org/developer-tools) ────
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=

# ─── Copyleaks (opcional) ────
COPYLEAKS_ACCESS_TOKEN=

# ─── App Móvil (Expo) ────
EXPO_PUBLIC_API_URL=https://kimy-api.onrender.com
EXPO_PUBLIC_PROJECT_ID=
